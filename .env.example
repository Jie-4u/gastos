# Copy this file to .env and replace development placeholders locally.
# Required: development for local work, test for automated tests, production for a public server.
APP_ENV=development
# Recommended locally: generate a unique value with secrets.token_urlsafe(48).
# A blank value is allowed only in development/test and generates an ephemeral key that resets sessions on restart.
# Production requires a persistent secret of at least 32 characters.
SECRET_KEY=
# Public origin used in invitation links. Use your permanent HTTPS deployment URL in production.
APP_BASE_URL=http://127.0.0.1:5000
# Set to 1 only when the app is behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=
# Leave blank for local SQLite. Production requires a PostgreSQL URL.
DATABASE_URL=

# Optional Brevo SMTP relay over STARTTLS (port 587).
# Leave credentials blank to create shareable invitations without sending email.
# Brevo SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Email sender
SMTP_FROM=
SMTP_FROM_NAME=Gastos

# PayMongo recurring subscriptions. Use plan IDs from the same mode as these keys.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PLAN_MONTHLY_ID=
PAYMONGO_PLAN_ANNUAL_ID=

# Class demos only: set to 1 to let the owner upgrade to Premium without a real payment.
DEMO_PAYMENTS=
